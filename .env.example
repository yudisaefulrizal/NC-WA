# Wajib diisi, misalnya hasil: openssl rand -hex 32
API_KEY=
PORT=8066
HOST=127.0.0.1

# Simpan kedua folder ini pada disk/volume permanen
AUTH_DIR=./auth
MEDIA_DIR=./data/media
MEDIA_RETENTION_DAYS=7

# Opsional; kosong berarti webhook dinonaktifkan
WEBHOOK_URL=
# URL engine yang dapat dijangkau aplikasi penerima webhook
BASE_URL=http://127.0.0.1:8066
# Jeda per session setelah pesan sebelumnya selesai (milidetik)
SEND_INTERVAL_MS=1000
